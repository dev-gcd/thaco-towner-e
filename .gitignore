# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare wrangler local state (D1 sandbox, cache, dev session)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# Tài liệu/ảnh gốc — local-only, không đưa lên repo
_docs/
# Local dev secrets (wrangler dev) — never committed
.dev.vars

# Local CMS dev server data (next dev)
.cms-dev/

# Regression screenshots (pnpm test:screens)
/_screens/

_docs/
